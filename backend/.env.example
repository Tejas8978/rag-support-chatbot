MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rag_support
PORT=3000
# Optional: without a key the bot returns the best matching passage instead of a generated answer
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
# Minimum cosine similarity for a passage to count as relevant (tune per your data)
RAG_MIN_SCORE=0.78
